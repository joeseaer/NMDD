ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-pro-260215

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Login credentials. Keep real values in the untracked .env file or the
# deployment platform's encrypted environment settings.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Local preview defaults. Add explicit comma-separated origins only when needed.
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto uses Supabase after the relationship migration exists; otherwise it
# selects the local JSON store once for the lifetime of the server process.
RELATIONSHIP_STORAGE_MODE=auto
# RELATIONSHIP_LOCAL_FILE=E:\\private-data\\relationship-system.local.json
